<div
  class="promo-banner"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
>
  <div class="page-width promo-banner__inner">
    <h2 class="promo-banner__heading">{{ section.settings.heading }}</h2>
    <p class="promo-banner__subtext">{{ section.settings.subtext }}</p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .promo-banner {
    padding: 3rem 0;
    text-align: center;
  }
  .promo-banner__heading {
    margin: 0 0 1rem;
  }
  .promo-banner__subtext {
    margin: 0 0 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Big sale this week" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Up to 40% off selected items" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffe9a8" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}
